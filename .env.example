# =============================================================================
# OK Footwear ERP — Environment Variables (example)
# =============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local — it is in .gitignore.
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=3000

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL 16) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=SCHEMA
DATABASE_URL=postgresql://ok_footwear:changeme@localhost:5432/ok_footwear_erp

# --- Redis 7 ---
# Format: redis://USER:PASSWORD@HOST:PORT
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Generate with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-random-64-byte-hex-string
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=30d

# --- AWS (S3 + SES) ---
# Leave empty in development to use MinIO / Mailpit
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=ok-footwear-dev

# --- SMS (SSL Wireless — Bangladesh) ---
SMS_API_URL=https://sms.sslwireless.com/api/v3
SMS_API_TOKEN=
SMS_SENDER_ID=OKFOOTWEAR
