# =============================================================================
# OK Footwear ERP — Docker Compose Environment Variables
# =============================================================================
# WARNING: This file contains dev secrets. NEVER commit to version control.
# .env.local is listed in .gitignore.
#
# Usage:
#   cp .env.local.example .env.local
#   docker compose up -d
#
# Service hosts inside Docker network:
#   postgres   → postgres:5432  (direct, for migrations)
#   pgbouncer  → pgbouncer:6432 (for app, transaction mode)
#   redis      → redis:6379
#   minio      → minio:9000
#   nestjs     → nestjs:7100
#   nginx      → nginx:80 (public entry point)
# =============================================================================

NODE_ENV=development
PORT=7100
ALLOWED_ORIGINS=http://localhost:80,http://localhost:7100

# Database (PostgreSQL 16 + PgBouncer transaction mode)
# DATABASE_URL: app → PgBouncer (port 6432, transaction mode)
# DIRECT_DATABASE_URL: for prisma migrate (bypasses PgBouncer)
DATABASE_URL=postgresql://ok_footwear:ok_footwear_dev@pgbouncer:6432/ok_footwear_erp?pgbouncer=true&connection_limit=20
DIRECT_DATABASE_URL=postgresql://ok_footwear:ok_footwear_dev@postgres:5432/ok_footwear_erp

# Redis 7 — internal Docker port 6379 (external host: 7379)
REDIS_URL=redis://redis:6379

# JWT — dev secret only; generate real one with: openssl rand -hex 64
JWT_SECRET=dev-secret-do-not-use-in-production-0123456789abcdef
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=30d

# MinIO (S3-compatible storage — replaces AWS S3 in dev)
# Console: http://localhost:9001 (login: minioadmin / minioadmin)
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=ok-footwear-dev

# SMS — SSL Wireless (Bangladesh)
# Leave token empty in dev to disable SMS sending
SMS_API_URL=https://sms.sslwireless.com/api/v3
SMS_API_TOKEN=
SMS_SENDER_ID=OKFOOTWEAR

# TOTP / HR PII — AES-256-GCM (64-char hex = 32 bytes); generate: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=3649ff438e7e1fc0f5169d2662003c1e83fb2cfcd33e01c7a94d3768c3879984
HR_PII_ENCRYPTION_KEY=a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef123456
HR_PF_INTEREST_RATE_PCT=8
