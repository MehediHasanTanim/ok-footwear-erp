// =============================================================================
// OK Footwear ERP — Prisma v5 Schema
// =============================================================================
// Multi-schema architecture: 9 PostgreSQL schemas mapped to business domains.
//
// Schemas:
//   sys  — System (users, roles, permissions, audit, document sequences)
//   auth — Authentication (refresh tokens, MFA, login audit)
//   ord  — Orders (buyers, orders, articles, quotations)
//   prc  — Procurement (vendors, purchase orders, GRN)
//   mfg  — Manufacturing (BOM, production orders, QC)
//   inv  — Inventory (warehouses, stock items, transactions)
//   fin  — Finance (chart of accounts, GL entries, bank accounts)
//   hr   — Human Resources (employees, payroll, leave, attendance)
//   brd  — Board Governance (directors, shareholders, meetings, resolutions, AGMs, dividends)
//
// PgBouncer: transaction mode enabled via pgbouncer=true in DATABASE_URL.
//   Connection limit: 20 — matches PgBouncer pool size.
//   Prisma's connection_limit controls the number of connections the query
//   engine opens to PgBouncer (not to PostgreSQL directly).
//
// Key design decisions:
//   - UUID v4 for all primary keys (gen_random_uuid() via pgcrypto extension).
//   - TIMESTAMPTZ for all timestamps (UTC-normalised).
//   - Soft-delete pattern: deleted_at column on mutable master-data tables.
//   - Append-only ledger tables never updated/deleted (enforced at app layer).
//   - snake_case column names (@map) to match PostgreSQL convention.
// =============================================================================

// ---------------------------------------------------------------------------
// Datasource
// ---------------------------------------------------------------------------
// DATABASE_URL must include:
//   ?pgbouncer=true       — disables prepared statements (required for
//                           PgBouncer transaction mode).
//   &connection_limit=20  — Prisma query engine pool size. Must match
//                           PgBouncer's max_client_conn (20).
//
// DIRECT_DATABASE_URL: direct PostgreSQL connection (bypasses PgBouncer).
//   Required for prisma migrate (DDL) — PgBouncer transaction mode does
//   not support CREATE/ALTER/DROP statements.
//
// Example DATABASE_URL:
//   postgresql://user:pass@pgbouncer:6432/db?pgbouncer=true&connection_limit=20
// Example DIRECT_DATABASE_URL:
//   postgresql://user:pass@postgres:5432/db
// ---------------------------------------------------------------------------

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
  schemas   = ["sys", "auth", "ord", "prc", "mfg", "inv", "fin", "hr", "brd"]
}

// ---------------------------------------------------------------------------
// Generator
// ---------------------------------------------------------------------------
// previewFeatures=["multiSchema"] enables @@schema() per model.
// multiSchema was promoted from preview to GA in Prisma ORM v5.18+,
// but we keep it in previewFeatures for compatibility with v5.0–v5.17.
// ---------------------------------------------------------------------------

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

// =============================================================================
// SCHEMA: sys — System (Core)
// =============================================================================
// Users, roles, permissions, document sequences, audit log.
// This schema is the foundation — all other schemas reference sys.users.

model DocumentSequence {
  prefix      String  @id @db.VarChar(10)
  lastNumber  Int     @default(0) @map("last_number")
  padLength   Int     @default(6) @map("pad_length")
  separator   String  @default("-") @db.Char(1)

  @@schema("sys")
  @@map("document_sequences")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@schema("sys")
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  module      String   @db.VarChar(50)
  action      String   @db.VarChar(50) // read, create, update, delete, approve, export
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@schema("sys")
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@schema("sys")
  @@map("role_permissions")
}

model User {
  id                   String    @id @default(uuid()) @db.Uuid
  employeeId           String?   @map("employee_id") @db.Uuid
  email                String    @unique @db.VarChar(255)
  passwordHash         String    @map("password_hash") @db.VarChar(255)
  totpSecretEncrypted  String?   @map("totp_secret_encrypted") @db.Text
  failedAttempts       Int       @default(0) @map("failed_attempts") @db.SmallInt
  lockedUntil          DateTime? @map("locked_until") @db.Timestamptz()
  firstName            String    @map("first_name") @db.VarChar(100)
  middleName           String?   @map("middle_name") @db.VarChar(100)
  lastName             String    @map("last_name") @db.VarChar(100)
  isActive             Boolean   @default(true) @map("is_active")
  lastLoginAt          DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz()

  userRoles      UserRole[]
  refreshTokens  RefreshToken[]
  complianceItems ComplianceItem[]

  @@schema("sys")
  @@map("users")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@schema("sys")
  @@map("user_roles")
}

model ComplianceItem {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(255)
  description       String?  @db.Text
  category          String?  @db.VarChar(100)
  expiryDate        DateTime @map("expiry_date") @db.Date
  responsibleUserId String?  @map("responsible_user_id") @db.Uuid
  alertDays         Int      @default(30) @map("alert_days") @db.SmallInt
  status            String   @default("valid") @db.VarChar(20)
  documentUrl       String?  @map("document_url") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  responsibleUser User? @relation(fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@index([expiryDate, responsibleUserId])
  @@schema("sys")
  @@map("compliance_items")
}

// =============================================================================
// SCHEMA: auth — Authentication
// =============================================================================
// Refresh tokens, MFA settings, login attempt audit.
// Separated from sys to isolate auth concerns and reduce blast radius.

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz()
  ipInet     String?   @map("ip_inet") @db.Inet
  userAgent  String?   @map("user_agent") @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  // Cross-schema relation: auth.refresh_tokens.user_id → sys.users.id
  // Prisma allows cross-schema relations when multiSchema is enabled.
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@schema("auth")
  @@map("refresh_tokens")
}

model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  email      String   @db.VarChar(255)
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent") @db.Text
  success    Boolean
  failureReason String? @map("failure_reason") @db.VarChar(255)
  attemptedAt DateTime @default(now()) @map("attempted_at") @db.Timestamptz()

  @@index([email, attemptedAt])
  @@schema("auth")
  @@map("login_attempts")
}

// =============================================================================
// SCHEMA: ord — Orders
// =============================================================================
// Buyers, articles, orders, order lines, order milestones.
//
// Order lifecycle: draft → confirmed → in_production → qc → packed → delivered
//   cancelled (terminal, reachable only from draft or confirmed)
//
// Sample approval gate: confirmed → in_production is BLOCKED unless
//   sample_approved = true. All other transitions are unaffected.

// ---------------------------------------------------------------------------
// ord.buyers — Customer/buyer master data (soft-delete)
// ---------------------------------------------------------------------------

model Buyer {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(200)
  currency      String    @db.VarChar(3) // ISO 4217
  paymentTerms  PaymentTerm @map("payment_terms")
  creditLimit   Decimal?  @map("credit_limit") @db.Decimal(15, 2)
  country       String?   @db.VarChar(100)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz()

  orders Order[]

  @@schema("ord")
  @@map("buyers")
}

enum PaymentTerm {
  LC_SIGHT
  LC_USANCE
  TT_ADVANCE
  TT_30_DAYS

  @@schema("ord")
}

// ---------------------------------------------------------------------------
// ord.articles — Article/style master data (soft-delete)
// ---------------------------------------------------------------------------

model Article {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(50)
  description String    @db.Text
  sizeSystem  String?   @map("size_system") @db.VarChar(20) // EU, UK, US
  category    String?   @db.VarChar(100)
  season      String?   @db.VarChar(50)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()

  orders     Order[]
  bomHeaders BomHeader[]

  @@schema("ord")
  @@map("articles")
}

// ---------------------------------------------------------------------------
// ord.orders — Sales order header
// ---------------------------------------------------------------------------

model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  orderNumber        String      @unique @map("order_number") @db.VarChar(20)
  buyerId            String      @map("buyer_id") @db.Uuid
  articleId          String      @map("article_id") @db.Uuid
  status             OrderStatus @default(draft)
  sampleApproved     Boolean     @default(false) @map("sample_approved")
  totalQuantity      Int         @map("total_quantity")
  deliveryDate       DateTime    @map("delivery_date") @db.Date
  currency           String      @db.VarChar(3) // ISO 4217
  confirmedAt        DateTime?   @map("confirmed_at") @db.Timestamptz()
  confirmedBy        String?     @map("confirmed_by") @db.Uuid
  cancelledAt        DateTime?   @map("cancelled_at") @db.Timestamptz()
  cancellationReason String?     @map("cancellation_reason") @db.Text
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  buyer        Buyer            @relation(fields: [buyerId], references: [id])
  article      Article          @relation(fields: [articleId], references: [id])
  orderLines   OrderLine[]
  milestones   OrderMilestone[]
  quotations   Quotation[]
  samples      Sample[]
  complaints   Complaint[]
  costSheets   CostSheet[]

  @@index([buyerId])
  @@index([articleId])
  @@index([status])
  @@index([deliveryDate])
  @@schema("ord")
  @@map("orders")
}

enum OrderStatus {
  draft
  confirmed
  in_production
  qc
  packed
  delivered
  cancelled

  @@schema("ord")
}

// ---------------------------------------------------------------------------
// ord.order_lines — Per-size quantities and pricing for each order
// ---------------------------------------------------------------------------

model OrderLine {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  sizeLabel String  @map("size_label") @db.VarChar(20) // e.g. "38", "UK6"
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, sizeLabel])
  @@index([orderId])
  @@schema("ord")
  @@map("order_lines")
}

// ---------------------------------------------------------------------------
// ord.order_milestones — Back-calculated milestone planning rows
// ---------------------------------------------------------------------------
// Generated once on order confirmation (draft → confirmed), never on create.
// planned_date is back-calculated from delivery_date using named lead-time
// constants defined in OrdersService (see generateMilestones()).
// status is set explicitly (pending → done when actual_date is set,
// or marked overdue by a scheduled job comparing planned_date to NOW()).
// We store status as a column rather than computing it, so query filtering
// is efficient and status transitions are explicit.

model OrderMilestone {
  id            String           @id @default(uuid()) @db.Uuid
  orderId       String           @map("order_id") @db.Uuid
  milestoneType MilestoneType    @map("milestone_type")
  plannedDate   DateTime         @map("planned_date") @db.Date
  actualDate    DateTime?        @map("actual_date") @db.Date
  status        MilestoneStatus  @default(pending)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, milestoneType])
  @@index([orderId])
  @@index([plannedDate, status])
  @@schema("ord")
  @@map("order_milestones")
}

enum MilestoneType {
  material_booking
  pp_sample
  bulk_start
  qc
  packing
  shipment

  @@schema("ord")
}

enum MilestoneStatus {
  pending
  done
  overdue

  @@schema("ord")
}

// ---------------------------------------------------------------------------
// ord.quotations — Commercial offers linked to an order (Sprint 4)
// ---------------------------------------------------------------------------

enum QuotationStatus {
  draft
  sent
  won
  lost

  @@schema("ord")
}

model Quotation {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotationNumber  String           @unique @map("quotation_number") @db.VarChar(20)
  orderId          String           @map("order_id") @db.Uuid
  order            Order            @relation(fields: [orderId], references: [id])
  status           QuotationStatus  @default(draft)
  bomVersionId     String?          @map("bom_version_id") @db.Uuid
  winProbability   Decimal?         @map("win_probability") @db.Decimal(5, 2)
  outcomeReason    String?          @map("outcome_reason") @db.Text
  costBreakdown    Json?            @map("cost_breakdown")
  totalCost        Decimal?         @map("total_cost") @db.Decimal(15, 2)
  quotedPrice      Decimal?         @map("quoted_price") @db.Decimal(15, 2)
  currency         String           @db.Char(3)
  sentAt           DateTime?        @map("sent_at") @db.Timestamptz()
  closedAt         DateTime?        @map("closed_at") @db.Timestamptz()
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([orderId])
  @@map("quotations")
  @@schema("ord")
}

// ---------------------------------------------------------------------------
// ord.samples — PP/Counter/Size-set/TOP samples per order round (Sprint 4)
// ---------------------------------------------------------------------------

enum SampleType {
  PP
  counter
  size_set
  TOP

  @@schema("ord")
}

enum ApprovalStatus {
  pending
  approved
  rejected

  @@schema("ord")
}

model Sample {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  order          Order          @relation(fields: [orderId], references: [id])
  roundNumber    Int            @map("round_number")
  sampleType     SampleType     @map("sample_type")
  dispatchDate   DateTime?      @map("dispatch_date") @db.Date
  receivedDate   DateTime?      @map("received_date") @db.Date
  approvalStatus ApprovalStatus @map("approval_status") @default(pending)
  approvedBy     String?        @map("approved_by") @db.Uuid
  approvedAt     DateTime?      @map("approved_at") @db.Timestamptz()
  remarks        String?        @db.Text
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([orderId, roundNumber, sampleType])
  @@index([orderId])
  @@map("samples")
  @@schema("ord")
}

// ---------------------------------------------------------------------------
// ord.complaints + ord.capa_actions — Complaint tracking & CAPA (Sprint 4)
// ---------------------------------------------------------------------------

enum ComplaintType {
  quality
  delivery
  packaging
  documentation
  other

  @@schema("ord")
}

enum Severity {
  low
  medium
  high
  critical

  @@schema("ord")
}

enum ComplaintStatus {
  open
  under_investigation
  resolved

  @@schema("ord")
}

model Complaint {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  complaintNumber  String          @unique @map("complaint_number") @db.VarChar(20)
  orderId          String          @map("order_id") @db.Uuid
  order            Order           @relation(fields: [orderId], references: [id])
  type             ComplaintType
  severity         Severity
  description      String          @db.Text
  rootCause        String?         @map("root_cause") @db.Text
  status           ComplaintStatus @default(open)
  raisedBy         String          @map("raised_by") @db.Uuid
  raisedAt         DateTime        @map("raised_at") @default(now()) @db.Timestamptz()
  resolvedAt       DateTime?       @map("resolved_at") @db.Timestamptz()
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  capaActions      CapaAction[]

  @@index([orderId])
  @@index([status, severity])
  @@map("complaints")
  @@schema("ord")
}

enum CapaActionStatus {
  open
  in_progress
  done

  @@schema("ord")
}

model CapaAction {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  complaintId  String            @map("complaint_id") @db.Uuid
  complaint    Complaint         @relation(fields: [complaintId], references: [id])
  description  String            @db.Text
  ownerId      String            @map("owner_id") @db.Uuid
  dueDate      DateTime          @map("due_date") @db.Date
  status       CapaActionStatus  @default(open)
  closedAt     DateTime?         @map("closed_at") @db.Timestamptz()
  evidence     String?           @db.Text
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([complaintId])
  @@index([ownerId, status])
  @@map("capa_actions")
  @@schema("ord")
}

// =============================================================================
// SCHEMA: prc — Procurement (Sprint 5)
// =============================================================================
// vendor_categories, vendors, POs, PO lines, GRNs, GR lines/photos, vendor invoices.

model VendorCategory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(100)
  code      String   @unique @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  vendors Vendor[]

  @@map("vendor_categories")
  @@schema("prc")
}

enum VendorType {
  raw_material
  sole
  accessory
  packaging
  machine
  service

  @@schema("prc")
}

enum VendorStatus {
  approved
  blacklisted
  under_review

  @@schema("prc")
}

model Vendor {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorCode    String       @unique @map("vendor_code") @db.VarChar(30)
  name          String       @db.VarChar(200)
  type          VendorType
  categoryId    String?      @map("category_id") @db.Uuid
  contactName   String?      @map("contact_name") @db.VarChar(100)
  email         String?      @db.VarChar(255)
  phone         String?      @db.VarChar(30)
  address       String?      @db.Text
  tradeLicense  String?      @map("trade_license") @db.VarChar(100)
  tinNumber     String?      @map("tin_number") @db.VarChar(50)
  bankName      String?      @map("bank_name") @db.VarChar(100)
  bankAccount   String?      @map("bank_account") @db.VarChar(50)
  paymentTerms  Int          @default(30) @map("payment_terms") @db.SmallInt
  creditLimit   Decimal      @default(0) @map("credit_limit") @db.Decimal(12, 2)
  status        VendorStatus @default(approved)
  rating        Decimal?     @db.Decimal(3, 1)
  notes         String?      @db.Text
  createdBy     String       @map("created_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  category       VendorCategory?  @relation(fields: [categoryId], references: [id])
  purchaseOrders PurchaseOrder[]
  invoices       VendorInvoice[]

  @@index([status])
  @@index([categoryId])
  @@map("vendors")
  @@schema("prc")
}

enum PurchaseOrderStatus {
  draft
  pending_approval
  approved
  partially_received
  received
  cancelled

  @@schema("prc")
}

model PurchaseOrder {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poNumber      String              @unique @map("po_number") @db.VarChar(30)
  vendorId      String              @map("vendor_id") @db.Uuid
  status        PurchaseOrderStatus @default(draft)
  currency      String              @default("BDT") @db.Char(3)
  totalAmount   Decimal             @default(0) @map("total_amount") @db.Decimal(15, 2)
  deliveryDate  DateTime            @map("delivery_date") @db.Date
  notes         String?             @db.Text
  rejectionReason String?           @map("rejection_reason") @db.Text
  requiredApproverRole String?      @map("required_approver_role") @db.VarChar(50)
  approvedBy    String?             @map("approved_by") @db.Uuid
  approvedAt    DateTime?           @map("approved_at") @db.Timestamptz()
  createdBy     String              @map("created_by") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  vendor Vendor           @relation(fields: [vendorId], references: [id])
  lines  PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]

  @@index([vendorId])
  @@index([status])
  @@map("purchase_orders")
  @@schema("prc")
}

model PurchaseOrderLine {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poId         String   @map("po_id") @db.Uuid
  itemId       String   @map("item_id") @db.Uuid
  orderedQty   Decimal  @map("ordered_qty") @db.Decimal(12, 3)
  receivedQty  Decimal  @default(0) @map("received_qty") @db.Decimal(12, 3)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 4)
  uom          String   @db.VarChar(20)
  deliveryDate DateTime? @map("delivery_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  grLines       GoodsReceiptLine[]

  @@index([poId])
  @@map("po_lines")
  @@schema("prc")
}

enum GoodsReceiptStatus {
  draft
  qc_pending
  approved
  rejected

  @@schema("prc")
}

model GoodsReceipt {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grnNumber    String             @unique @map("grn_number") @db.VarChar(30)
  poId         String             @map("po_id") @db.Uuid
  receiptDate  DateTime           @default(dbgenerated("CURRENT_DATE")) @map("receipt_date") @db.Date
  status       GoodsReceiptStatus @default(draft)
  receivedBy   String             @map("received_by") @db.Uuid
  approvedBy   String?            @map("approved_by") @db.Uuid
  approvedAt   DateTime?          @map("approved_at") @db.Timestamptz()
  vehicleNo    String?            @map("vehicle_no") @db.VarChar(50)
  notes        String?            @db.Text
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz()

  purchaseOrder PurchaseOrder       @relation(fields: [poId], references: [id])
  lines         GoodsReceiptLine[]
  invoices      VendorInvoice[]

  @@index([poId])
  @@map("goods_receipts")
  @@schema("prc")
}

enum GrLineQcStatus {
  pending
  accepted
  rejected
  hold

  @@schema("prc")
}

model GoodsReceiptLine {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grnId            String        @map("grn_id") @db.Uuid
  poLineId         String        @map("po_line_id") @db.Uuid
  receivedQty      Decimal       @map("received_qty") @db.Decimal(12, 3)
  acceptedQty      Decimal       @default(0) @map("accepted_qty") @db.Decimal(12, 3)
  rejectedQty      Decimal       @default(0) @map("rejected_qty") @db.Decimal(12, 3)
  qcStatus         GrLineQcStatus @default(pending) @map("qc_status")
  rejectionReason  String?       @map("rejection_reason") @db.Text
  batchLot         String?       @map("batch_lot") @db.VarChar(50)
  unitCost         Decimal?      @map("unit_cost") @db.Decimal(12, 4)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  goodsReceipt GoodsReceipt        @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poLine       PurchaseOrderLine   @relation(fields: [poLineId], references: [id])
  photos       GoodsReceiptLinePhoto[]

  @@index([grnId])
  @@map("gr_lines")
  @@schema("prc")
}

model GoodsReceiptLinePhoto {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grLineId    String   @map("gr_line_id") @db.Uuid
  s3Key       String   @map("s3_key") @db.VarChar(500)
  contentType String   @map("content_type") @db.VarChar(100)
  uploadedBy  String   @map("uploaded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  grLine GoodsReceiptLine @relation(fields: [grLineId], references: [id], onDelete: Cascade)

  @@index([grLineId])
  @@map("gr_line_photos")
  @@schema("prc")
}

enum VendorInvoiceStatus {
  pending
  partial
  paid
  disputed
  cancelled

  @@schema("prc")
}

model VendorInvoice {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId     String              @map("vendor_id") @db.Uuid
  invoiceNo    String              @map("invoice_no") @db.VarChar(50)
  invoiceDate  DateTime            @map("invoice_date") @db.Date
  dueDate      DateTime            @map("due_date") @db.Date
  currency     String              @default("BDT") @db.Char(3)
  grossAmount  Decimal             @map("gross_amount") @db.Decimal(15, 2)
  tdsAmount    Decimal             @default(0) @map("tds_amount") @db.Decimal(12, 2)
  netPayable   Decimal             @map("net_payable") @db.Decimal(15, 2)
  paidAmount   Decimal             @default(0) @map("paid_amount") @db.Decimal(15, 2)
  status       VendorInvoiceStatus @default(pending)
  grnId        String?             @map("grn_id") @db.Uuid
  glEntryId    String?             @map("gl_entry_id") @db.Uuid
  createdBy    String              @map("created_by") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz()

  vendor       Vendor        @relation(fields: [vendorId], references: [id])
  goodsReceipt GoodsReceipt? @relation(fields: [grnId], references: [id])

  @@unique([vendorId, invoiceNo])
  @@index([vendorId])
  @@index([status])
  @@index([dueDate])
  @@map("vendor_invoices")
  @@schema("prc")
}

// =============================================================================
// SCHEMA: mfg — Manufacturing
// =============================================================================
// BOM, production orders, QC inspections, machines, lasts & moulds.

model BomHeader {
  id         String    @id @default(uuid()) @db.Uuid
  articleId  String    @map("article_id") @db.Uuid
  version    String    @default("1.0")
  status     String    @default("draft") // draft|approved|superseded
  approvedBy String?   @map("approved_by") @db.Uuid
  approvedAt DateTime? @map("approved_at") @db.Timestamptz()
  notes      String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy  String    @map("created_by") @db.Uuid

  article        Article           @relation(fields: [articleId], references: [id])
  lines          BomLine[]
  sizeOverrides  BomSizeOverride[]
  costSheets     CostSheet[]

  @@unique([articleId, version])
  @@index([articleId])
  @@schema("mfg")
  @@map("bom_headers")
}

model BomLine {
  id               String   @id @default(uuid()) @db.Uuid
  bomId            String   @map("bom_id") @db.Uuid
  itemId           String   @map("item_id") @db.Uuid
  componentType    String   @map("component_type")
  quantityPerPair  Decimal  @map("quantity_per_pair") @db.Decimal(10, 4)
  uom              String
  sizeSpecific     Boolean  @default(false) @map("size_specific")
  sizeLabel        String?  @map("size_label")
  wastagePct       Decimal  @default(0) @map("wastage_pct") @db.Decimal(5, 2)
  notes            String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  bom  BomHeader @relation(fields: [bomId], references: [id], onDelete: Cascade)
  item StockItem @relation(fields: [itemId], references: [id])

  @@index([bomId])
  @@index([itemId])
  @@schema("mfg")
  @@map("bom_lines")
}

model BomSizeOverride {
  id         String  @id @default(uuid()) @db.Uuid
  bomId      String  @map("bom_id") @db.Uuid
  itemId     String  @map("item_id") @db.Uuid
  sizeLabel  String  @map("size_label")
  qtyPerUnit Decimal @map("qty_per_unit") @db.Decimal(10, 4)

  bom  BomHeader @relation(fields: [bomId], references: [id], onDelete: Cascade)
  item StockItem @relation(fields: [itemId], references: [id])

  @@unique([bomId, itemId, sizeLabel])
  @@index([bomId])
  @@schema("mfg")
  @@map("bom_size_overrides")
}

model CostSheet {
  id            String    @id @default(uuid()) @db.Uuid
  orderId       String?   @map("order_id") @db.Uuid
  bomId         String    @map("bom_id") @db.Uuid
  status        String    @default("draft") // draft|approved|finalised
  materialCost  Decimal   @default(0) @map("material_cost") @db.Decimal(12, 4)
  trimsCost     Decimal   @default(0) @map("trims_cost") @db.Decimal(12, 4)
  labourCost    Decimal   @default(0) @map("labour_cost") @db.Decimal(12, 4)
  overheadCost  Decimal   @default(0) @map("overhead_cost") @db.Decimal(12, 4)
  totalCost     Decimal   @default(0) @map("total_cost") @db.Decimal(12, 4)
  marginPct     Decimal   @default(0) @map("margin_pct") @db.Decimal(5, 2)
  sellingPrice  Decimal   @default(0) @map("selling_price") @db.Decimal(12, 4)
  actualCost    Decimal?  @map("actual_cost") @db.Decimal(12, 4)
  variance      Decimal?  @db.Decimal(12, 4)
  approvedBy    String?   @map("approved_by") @db.Uuid
  approvedAt    DateTime? @map("approved_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy     String    @map("created_by") @db.Uuid

  bom   BomHeader @relation(fields: [bomId], references: [id])
  order Order?    @relation(fields: [orderId], references: [id])

  @@index([bomId])
  @@schema("mfg")
  @@map("cost_sheets")
}

// =============================================================================
// SCHEMA: inv — Inventory
// =============================================================================
// Warehouses, stock items, balances, stock counts.
// stock_transactions is PARTITIONED — not modeled in Prisma; use $queryRaw.
// Status/type/category stored as TEXT + CHECK in SQL (not PG enums).

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  code      String   @unique @db.VarChar(20)
  location  String?  @db.VarChar(200)
  type      String   @default("general") // raw_material|accessories|finished_goods|packing|general
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  balances    StockBalance[]
  stockCounts StockCount[]

  @@schema("inv")
  @@map("warehouses")
}

model StockItem {
  id           String   @id @default(uuid()) @db.Uuid
  itemCode     String   @unique @map("item_code") @db.VarChar(50)
  name         String   @db.VarChar(200)
  category     String // raw_material|sole|accessory|packing|finished_goods
  subCategory  String?  @map("sub_category") @db.Text
  uom          String   @default("PCS") @db.VarChar(20)
  reorderLevel Decimal  @default(0) @map("reorder_level") @db.Decimal(12, 3)
  minStock     Decimal  @default(0) @map("min_stock") @db.Decimal(12, 3)
  maxStock     Decimal? @map("max_stock") @db.Decimal(12, 3)
  leadTimeDays Int      @default(7) @map("lead_time_days") @db.SmallInt
  hsnCode      String?  @map("hsn_code") @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy    String?  @map("created_by") @db.Uuid

  balances         StockBalance[]
  countLines       StockCountLine[]
  bomLines         BomLine[]
  bomSizeOverrides BomSizeOverride[]

  @@schema("inv")
  @@map("stock_items")
}

model StockBalance {
  itemId      String   @map("item_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  quantity    Decimal  @default(0) @db.Decimal(12, 3)
  avgCost     Decimal  @default(0) @map("avg_cost") @db.Decimal(12, 4)
  lastUpdated DateTime @default(now()) @map("last_updated") @db.Timestamptz()

  item      StockItem @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@id([itemId, warehouseId])
  @@schema("inv")
  @@map("stock_balances")
}

model StockCount {
  id          String    @id @default(uuid()) @db.Uuid
  countNumber String    @unique @map("count_number")
  countDate   DateTime  @default(now()) @map("count_date") @db.Date
  warehouseId String    @map("warehouse_id") @db.Uuid
  status      String    @default("open") // open|counting|variance_review|approved|cancelled
  approvedBy  String?   @map("approved_by") @db.Uuid
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  createdBy   String    @map("created_by") @db.Uuid

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  lines     StockCountLine[]

  @@index([warehouseId, status])
  @@schema("inv")
  @@map("stock_counts")
}

model StockCountLine {
  id             String   @id @default(uuid()) @db.Uuid
  countId        String   @map("count_id") @db.Uuid
  itemId         String   @map("item_id") @db.Uuid
  systemQty      Decimal  @map("system_qty") @db.Decimal(12, 3)
  physicalQty    Decimal? @map("physical_qty") @db.Decimal(12, 3)
  // variance is GENERATED ALWAYS in SQL — read-only in Prisma
  variance       Decimal? @db.Decimal(12, 3)
  varianceReason String?  @map("variance_reason") @db.Text

  count StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  item  StockItem  @relation(fields: [itemId], references: [id])

  @@unique([countId, itemId])
  @@index([countId])
  @@schema("inv")
  @@map("stock_count_lines")
}

// =============================================================================
// SCHEMA: fin — Finance
// =============================================================================
// Chart of accounts, GL headers/periods, bank accounts, delivery challans, AR.
// Note: fin.gl_entry_lines is PARTITIONED — no Prisma model; use $queryRaw only.

model ChartOfAccount {
  id            String      @id @default(uuid()) @db.Uuid
  accountCode   String      @unique @map("account_code") @db.VarChar(20)
  name          String      @db.Text
  accountType   AccountType @map("account_type")
  accountClass  String      @default("general") @map("account_class") @db.Text
  parentId      String?     @map("parent_id") @db.Uuid
  isControl     Boolean     @default(false) @map("is_control")
  currency      String      @default("BDT") @db.Char(3)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  parent       ChartOfAccount?  @relation("CoAHierarchy", fields: [parentId], references: [id])
  children     ChartOfAccount[] @relation("CoAHierarchy")
  bankAccounts BankAccount[]

  @@index([parentId])
  @@schema("fin")
  @@map("chart_of_accounts")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE

  @@schema("fin")
}

model GlPeriod {
  id          String    @id @default(uuid()) @db.Uuid
  periodYear  Int       @map("period_year") @db.SmallInt
  periodMonth Int       @map("period_month") @db.SmallInt
  status      String    @default("open") // open | closed | locked
  closedBy    String?   @map("closed_by") @db.Uuid
  closedAt    DateTime? @map("closed_at") @db.Timestamptz()

  entries GlEntry[]

  @@unique([periodYear, periodMonth])
  @@schema("fin")
  @@map("gl_periods")
}

model GlEntry {
  id            String    @id @default(uuid()) @db.Uuid
  entryNumber   String    @unique @map("entry_number")
  periodId      String    @map("period_id") @db.Uuid
  entryDate     DateTime  @map("entry_date") @db.Date
  entryType     String    @default("manual") @map("entry_type")
  sourceModule  String?   @map("source_module")
  sourceId      String?   @map("source_id") @db.Uuid
  narration     String
  status        String    @default("draft")
  reversalOf    String?   @map("reversal_of") @db.Uuid
  postedAt      DateTime? @map("posted_at") @db.Timestamptz()
  postedBy      String?   @map("posted_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  createdBy     String    @map("created_by") @db.Uuid

  period            GlPeriod         @relation(fields: [periodId], references: [id])
  reversalOfEntry   GlEntry?         @relation("GlReversal", fields: [reversalOf], references: [id])
  reversals         GlEntry[]        @relation("GlReversal")
  bankTransactions  BankTransaction[]
  buyerInvoices     BuyerInvoice[]

  @@index([periodId, status])
  @@index([sourceModule, sourceId])
  @@schema("fin")
  @@map("gl_entries")
}

model BankAccount {
  id            String   @id @default(uuid()) @db.Uuid
  accountName   String   @map("account_name")
  bankName      String   @map("bank_name")
  branch        String?
  accountNumber String   @map("account_number")
  accountType   String   @map("account_type") // current | savings | od | lc
  currency      String   @default("BDT") @db.Char(3)
  glAccountId   String   @map("gl_account_id") @db.Uuid
  isPayroll     Boolean  @default(false) @map("is_payroll")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  glAccount    ChartOfAccount    @relation(fields: [glAccountId], references: [id])
  transactions BankTransaction[]

  @@schema("fin")
  @@map("bank_accounts")
}

model BankTransaction {
  id            String    @id @default(uuid()) @db.Uuid
  bankAccountId String    @map("bank_account_id") @db.Uuid
  txnDate       DateTime  @map("txn_date") @db.Date
  valueDate     DateTime? @map("value_date") @db.Date
  txnType       String    @map("txn_type") // debit | credit
  amount        Decimal   @db.Decimal(15, 2)
  description   String?
  referenceNo   String?   @map("reference_no")
  isReconciled  Boolean   @default(false) @map("is_reconciled")
  glEntryId     String?   @map("gl_entry_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
  glEntry     GlEntry?    @relation(fields: [glEntryId], references: [id])

  @@index([bankAccountId, txnDate(sort: Desc)])
  @@schema("fin")
  @@map("bank_transactions")
}

model DeliveryChallan {
  id          String    @id @default(uuid()) @db.Uuid
  dcNumber    String    @unique @map("dc_number")
  orderId     String    @map("order_id") @db.Uuid
  exportLcId  String?   @map("export_lc_id") @db.Uuid
  dcDate      DateTime  @default(now()) @map("dc_date") @db.Date
  vehicleNo   String?   @map("vehicle_no")
  carrier     String?
  dispatchBy  String?   @map("dispatch_by") @db.Uuid
  status      String    @default("draft")
  podDate     DateTime? @map("pod_date") @db.Date
  podReceiver String?   @map("pod_receiver")
  podNotes    String?   @map("pod_notes")
  podPhotoKey String?   @map("pod_photo_key")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy   String    @map("created_by") @db.Uuid

  lines          DcLine[]
  buyerInvoices  BuyerInvoice[]

  @@index([orderId])
  @@schema("fin")
  @@map("delivery_challans")
}

model DcLine {
  id          String   @id @default(uuid()) @db.Uuid
  dcId        String   @map("dc_id") @db.Uuid
  orderLineId String   @map("order_line_id") @db.Uuid
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 4)
  // amount is GENERATED ALWAYS in DB — read-only via raw query if needed
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  challan DeliveryChallan @relation(fields: [dcId], references: [id], onDelete: Cascade)

  @@index([dcId])
  @@schema("fin")
  @@map("dc_lines")
}

model BuyerInvoice {
  id               String    @id @default(uuid()) @db.Uuid
  invoiceNo        String    @unique @map("invoice_no")
  buyerId          String    @map("buyer_id") @db.Uuid
  dcId             String    @map("dc_id") @db.Uuid
  invoiceDate      DateTime  @default(now()) @map("invoice_date") @db.Date
  dueDate          DateTime  @map("due_date") @db.Date
  currency         String    @default("USD") @db.Char(3)
  grossAmount      Decimal   @map("gross_amount") @db.Decimal(15, 2)
  collectedAmount  Decimal   @default(0) @map("collected_amount") @db.Decimal(15, 2)
  status           String    @default("unpaid")
  glEntryId        String?   @map("gl_entry_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy        String    @map("created_by") @db.Uuid

  challan DeliveryChallan @relation(fields: [dcId], references: [id])
  glEntry GlEntry?        @relation(fields: [glEntryId], references: [id])

  @@index([buyerId])
  @@schema("fin")
  @@map("buyer_invoices")
}

// =============================================================================
// SCHEMA: hr — Human Resources
// =============================================================================
// Employees, payroll, leave, attendance, PF, gratuity.

model Employee {
  id             String    @id @default(uuid()) @db.Uuid
  employeeCode   String    @unique @map("employee_code") @db.VarChar(20)
  firstName      String    @map("first_name") @db.VarChar(100)
  middleName     String?   @map("middle_name") @db.VarChar(100)
  lastName       String    @map("last_name") @db.VarChar(100)
  email          String?   @db.VarChar(255)
  phone          String?   @db.VarChar(30)
  department     String?   @db.VarChar(100)
  designation    String?   @db.VarChar(100)
  joiningDate    DateTime? @map("joining_date") @db.Date
  employmentType String?   @map("employment_type") @db.VarChar(20) // permanent, contract, daily
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz()

  @@schema("hr")
  @@map("employees")
}

// =============================================================================
// SCHEMA: brd — Board Governance
// =============================================================================
// Directors, shareholders, share transactions, board meetings, resolutions,
// AGMs/EGMs, dividends, related-party register.
// 13 tables total — corporate governance domain.
// Reference: Companies Act 1994 (Bangladesh), RJSC compliance.

model Director {
  id                 String             @id @default(uuid()) @db.Uuid
  firstName          String             @map("first_name") @db.VarChar(100)
  middleName         String?            @map("middle_name") @db.VarChar(100)
  lastName           String             @map("last_name") @db.VarChar(100)
  fatherName         String?            @map("father_name") @db.VarChar(200)
  din                String?            @unique @db.VarChar(50)
  nidEncrypted       Bytes?             @map("nid_encrypted")
  passportEncrypted  Bytes?             @map("passport_encrypted")
  dateOfBirth        DateTime?          @map("date_of_birth") @db.Date
  nationality        String             @default("Bangladeshi") @db.VarChar(100)
  address            String?            @db.Text
  email              String?            @db.VarChar(255)
  phone              String?            @db.VarChar(30)
  designation        DirectorDesignation
  appointmentDate    DateTime           @map("appointment_date") @db.Date
  tenureYears        Int?               @map("tenure_years")
  resignationDate    DateTime?          @map("resignation_date") @db.Date
  status             DirectorStatus     @default(ACTIVE)
  qualificationShares Int              @default(0) @map("qualification_shares")
  employeeId         String?            @map("employee_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy          String             @map("created_by") @db.Uuid

  shareholders      Shareholder[]
  meetingAttendees  MeetingAttendee[]
  relatedParties    RelatedParty[]

  @@schema("brd")
  @@map("directors")
}

enum DirectorDesignation {
  CHAIRMAN
  MANAGING_DIRECTOR
  EXECUTIVE_DIRECTOR
  INDEPENDENT_DIRECTOR
  NOMINEE_DIRECTOR
  NON_EXECUTIVE_DIRECTOR

  @@schema("brd")
}

enum DirectorStatus {
  ACTIVE
  RESIGNED
  REMOVED
  DECEASED

  @@schema("brd")
}

model Shareholder {
  id              String          @id @default(uuid()) @db.Uuid
  shareholderType ShareholderType @map("shareholder_type")
  name            String          @db.VarChar(200)
  nidOrReg        String?         @map("nid_or_reg") @db.VarChar(50)
  address         String?         @db.Text
  email           String?         @db.VarChar(255)
  phone           String?         @db.VarChar(30)
  directorId      String?         @map("director_id") @db.Uuid
  isNominee       Boolean         @default(false) @map("is_nominee")
  beneficialOwner String?         @map("beneficial_owner") @db.VarChar(200)
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  director              Director?           @relation(fields: [directorId], references: [id])
  shareTransactionsFrom ShareTransaction[]  @relation("FromShareholder")
  shareTransactionsTo   ShareTransaction[]  @relation("ToShareholder")
  shareCertificates     ShareCertificate[]
  agmProxies            AgmProxy[]
  dividendPayments      DividendPayment[]

  @@schema("brd")
  @@map("shareholders")
}

enum ShareholderType {
  INDIVIDUAL
  CORPORATE

  @@schema("brd")
}

// Append-only ledger — never updated or deleted
model ShareTransaction {
  id              String        @id @default(uuid()) @db.Uuid
  txnType         ShareTxnType  @map("txn_type")
  txnDate         DateTime      @map("txn_date") @db.Date
  fromShareholder String?       @map("from_shareholder") @db.Uuid
  toShareholder   String        @map("to_shareholder") @db.Uuid
  shares          Int
  pricePerShare   Decimal?      @map("price_per_share") @db.Decimal(12, 4)
  resolutionId    String?       @map("resolution_id") @db.Uuid
  approvedBy      String        @map("approved_by") @db.Uuid
  notes           String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  fromShareholderRel Shareholder? @relation("FromShareholder", fields: [fromShareholder], references: [id])
  toShareholderRel   Shareholder  @relation("ToShareholder", fields: [toShareholder], references: [id])

  @@index([toShareholder, txnDate(sort: Desc)])
  @@schema("brd")
  @@map("share_transactions")
}

enum ShareTxnType {
  ALLOTMENT
  TRANSFER
  BUYBACK
  BONUS

  @@schema("brd")
}

model ShareCertificate {
  id             String             @id @default(uuid()) @db.Uuid
  certNumber     String             @unique @map("cert_number") @db.VarChar(50)
  shareholderId  String             @map("shareholder_id") @db.Uuid
  shares         Int
  issueDate      DateTime           @map("issue_date") @db.Date
  cancelledDate  DateTime?          @map("cancelled_date") @db.Date
  status         CertificateStatus  @default(ACTIVE)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz()

  shareholder Shareholder @relation(fields: [shareholderId], references: [id])

  @@schema("brd")
  @@map("share_certificates")
}

enum CertificateStatus {
  ACTIVE
  CANCELLED

  @@schema("brd")
}

model BoardMeeting {
  id             String         @id @default(uuid()) @db.Uuid
  meetingType    MeetingType    @map("meeting_type")
  scheduledAt    DateTime       @map("scheduled_at") @db.Timestamptz()
  venue          String?        @db.VarChar(300)
  videoLink      String?        @map("video_link") @db.VarChar(500)
  quorumRequired Int            @default(2) @map("quorum_required")
  status         MeetingStatus  @default(SCHEDULED)
  minutesSigned  Boolean        @default(false) @map("minutes_signed")
  signedAt       DateTime?      @map("signed_at") @db.Timestamptz()
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy      String         @map("created_by") @db.Uuid

  agenda      MeetingAgenda[]
  attendees   MeetingAttendee[]
  resolutions Resolution[]

  @@schema("brd")
  @@map("board_meetings")
}

enum MeetingType {
  REGULAR
  SPECIAL
  CIRCULAR

  @@schema("brd")
}

enum MeetingStatus {
  SCHEDULED
  HELD
  ADJOURNED
  CANCELLED
  INQUORATE

  @@schema("brd")
}

model MeetingAgenda {
  id          String   @id @default(uuid()) @db.Uuid
  meetingId   String   @map("meeting_id") @db.Uuid
  sequence    Int
  title       String   @db.VarChar(300)
  description String?  @db.Text
  presenter   String?  @db.VarChar(100)
  timeMinutes Int?     @map("time_minutes")

  resolutions Resolution[]

  meeting BoardMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, sequence])
  @@schema("brd")
  @@map("meeting_agenda")
}

model MeetingAttendee {
  id          String     @id @default(uuid()) @db.Uuid
  meetingId   String     @map("meeting_id") @db.Uuid
  directorId  String     @map("director_id") @db.Uuid
  attendance  Attendance @default(PRESENT)

  meeting  BoardMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  director Director     @relation(fields: [directorId], references: [id])

  @@unique([meetingId, directorId])
  @@schema("brd")
  @@map("meeting_attendees")
}

enum Attendance {
  PRESENT
  VIDEO
  ABSENT
  LEAVE_OF_ABSENCE

  @@schema("brd")
}

// Append-only after approval
model Resolution {
  id               String             @id @default(uuid()) @db.Uuid
  resolutionNumber String             @unique @map("resolution_number") @db.VarChar(20)
  meetingId        String?            @map("meeting_id") @db.Uuid
  agendaId         String?            @map("agenda_id") @db.Uuid
  resolutionDate   DateTime           @map("resolution_date") @db.Date
  resolutionType   ResolutionType     @map("resolution_type")
  category         ResolutionCategory
  title            String             @db.VarChar(300)
  resolutionText   String             @map("resolution_text") @db.Text
  votesFor         Int                @default(0) @map("votes_for")
  votesAgainst     Int                @default(0) @map("votes_against")
  votesAbstained   Int                @default(0) @map("votes_abstained")
  outcome          ResolutionOutcome  @default(PASSED)
  signedAt         DateTime?          @map("signed_at") @db.Timestamptz()
  sha256Hash       String?            @map("sha256_hash") @db.VarChar(64)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  createdBy        String             @map("created_by") @db.Uuid

  meeting   BoardMeeting?  @relation(fields: [meetingId], references: [id])
  agenda    MeetingAgenda? @relation(fields: [agendaId], references: [id])
  dividends Dividend[]

  @@schema("brd")
  @@map("resolutions")
}

enum ResolutionType {
  ORDINARY
  SPECIAL
  CIRCULAR

  @@schema("brd")
}

enum ResolutionCategory {
  FINANCIAL
  APPOINTMENT
  POLICY
  CONTRACT
  REGULATORY
  DIVIDEND
  SHARE
  OTHER

  @@schema("brd")
}

enum ResolutionOutcome {
  PASSED
  FAILED
  DEFERRED
  WITHDRAWN

  @@schema("brd")
}

model Agm {
  id             String      @id @default(uuid()) @db.Uuid
  meetingType    AgmType     @map("meeting_type")
  financialYear  Int         @map("financial_year")
  meetingDate    DateTime    @map("meeting_date") @db.Timestamptz()
  venue          String?     @db.VarChar(300)
  noticeSentAt   DateTime?   @map("notice_sent_at") @db.Timestamptz()
  status         AgmStatus   @default(SCHEDULED)
  minutesUrl     String?     @map("minutes_url") @db.VarChar(500)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz()
  createdBy      String      @map("created_by") @db.Uuid

  proxies AgmProxy[]

  @@schema("brd")
  @@map("agms")
}

enum AgmType {
  AGM
  EGM

  @@schema("brd")
}

enum AgmStatus {
  SCHEDULED
  HELD
  ADJOURNED
  CANCELLED

  @@schema("brd")
}

model AgmProxy {
  id                String   @id @default(uuid()) @db.Uuid
  agmId             String   @map("agm_id") @db.Uuid
  shareholderId     String   @map("shareholder_id") @db.Uuid
  proxyHolder       String   @map("proxy_holder") @db.VarChar(200)
  sharesRepresented Int      @map("shares_represented")
  proxyDate         DateTime @map("proxy_date") @db.Date

  agm         Agm         @relation(fields: [agmId], references: [id])
  shareholder Shareholder @relation(fields: [shareholderId], references: [id])

  @@unique([agmId, shareholderId])
  @@schema("brd")
  @@map("agm_proxies")
}

model Dividend {
  id                 String          @id @default(uuid()) @db.Uuid
  financialYear      Int             @map("financial_year")
  dividendType       DividendType    @map("dividend_type")
  declarationDate    DateTime        @map("declaration_date") @db.Date
  recordDate         DateTime        @map("record_date") @db.Date
  paymentDate        DateTime        @map("payment_date") @db.Date
  ratePerShare       Decimal         @map("rate_per_share") @db.Decimal(10, 4)
  totalDividend      Decimal         @map("total_dividend") @db.Decimal(16, 2)
  withholdingTaxPct  Decimal         @default(10) @map("withholding_tax_pct") @db.Decimal(5, 2)
  status             DividendStatus  @default(DECLARED)
  resolutionId       String?         @map("resolution_id") @db.Uuid
  glEntryId          String?         @map("gl_entry_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  createdBy          String          @map("created_by") @db.Uuid

  resolution Resolution?         @relation(fields: [resolutionId], references: [id])
  payments   DividendPayment[]

  @@schema("brd")
  @@map("dividends")
}

enum DividendType {
  INTERIM
  FINAL

  @@schema("brd")
}

enum DividendStatus {
  DECLARED
  APPROVED
  PAID

  @@schema("brd")
}

model DividendPayment {
  id             String                 @id @default(uuid()) @db.Uuid
  dividendId     String                 @map("dividend_id") @db.Uuid
  shareholderId  String                 @map("shareholder_id") @db.Uuid
  sharesHeld     Int                    @map("shares_held")
  grossAmount    Decimal                @map("gross_amount") @db.Decimal(12, 2)
  taxDeducted    Decimal                @default(0) @map("tax_deducted") @db.Decimal(10, 2)
  netAmount      Decimal                @map("net_amount") @db.Decimal(12, 2)
  paymentStatus  DividendPaymentStatus  @default(PENDING) @map("payment_status")
  paidAt         DateTime?              @map("paid_at") @db.Timestamptz()

  dividend    Dividend    @relation(fields: [dividendId], references: [id])
  shareholder Shareholder @relation(fields: [shareholderId], references: [id])

  @@unique([dividendId, shareholderId])
  @@schema("brd")
  @@map("dividend_payments")
}

enum DividendPaymentStatus {
  PENDING
  PAID
  UNCLAIMED

  @@schema("brd")
}

model RelatedParty {
  id           String                  @id @default(uuid()) @db.Uuid
  name         String                  @db.VarChar(200)
  relationship String                  @db.VarChar(100)
  directorId   String?                 @map("director_id") @db.Uuid
  entityType   RelatedPartyEntityType  @map("entity_type")
  notes        String?                 @db.Text
  isActive     Boolean                 @default(true) @map("is_active")
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz()

  director Director? @relation(fields: [directorId], references: [id])

  @@schema("brd")
  @@map("related_parties")
}

enum RelatedPartyEntityType {
  INDIVIDUAL
  COMPANY

  @@schema("brd")
}
